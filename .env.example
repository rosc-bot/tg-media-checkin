# Web 管理面板管理员登录凭据
ADMIN_USERNAME=admin
ADMIN_PASSWORD=your_secure_password_here

# JWT 鉴权密钥（填一段长随机字符串）
JWT_SECRET=your_jwt_secret_random_key_here

# 数据加密密钥（用于敏感字段加密存储，建议32位字符串）
BEMBY_DATA_KEY=your_32_char_data_encryption_key

# 服务运行端口与时区
PORT=3000
TZ=Asia/Shanghai

# 批量账号管理开关（true / false）
BULK_ACCOUNT_MANAGEMENT=true
